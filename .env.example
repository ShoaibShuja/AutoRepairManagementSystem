# Browser-safe Supabase connection values. These are exposed to the browser by Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Canonical deployed origin used for magic-link callbacks, for example https://app.example.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Do not expose this key to the browser or commit a populated .env file.
# Required for the administrator-only staff creation and account suspension actions.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
