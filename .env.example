# Browser-safe Supabase connection values. These are exposed to the browser by Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only. Do not expose this key to the browser or commit a populated .env file.
# Required only for tightly scoped server-side administration tasks introduced in later phases.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
